<brls:Box
    axis="row"
    width="auto"
    height="auto"
    paddingTop="8"
    paddingRight="@style/hub/space/screen"
    paddingBottom="10"
    paddingLeft="@style/hub/space/screen">

    <brls:Box
        id="library/sidebar"
        axis="column"
        width="200"
        marginRight="20" />

    <brls:Box
        axis="column"
        grow="1.0">

        <brls:Label
            id="library/empty"
            text=""
            fontSize="@style/hub/font/caption"
            textColor="@theme/brls/text_disabled"
            visibility="gone"
            marginTop="40" />

        <!-- RecyclerFrame, а не список плиток в WrapBox: без переиспользования
             сотня избранного держала бы сотню текстур сразу. -->
        <brls:RecyclerFrame
            id="library/grid"
            width="auto"
            height="auto"
            grow="1.0" />

    </brls:Box>

</brls:Box>
