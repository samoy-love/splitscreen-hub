<brls:Box
    axis="column"
    width="auto"
    height="auto"
    paddingTop="@style/hub/space/xs"
    paddingRight="@style/hub/space/screen"
    paddingBottom="@style/hub/space/xs"
    paddingLeft="@style/hub/space/screen">

    <!-- Два явных ряда вместо одного переносящегося.
         Контейнер-строка в borealis проводит фокус только влево-вправо, а вниз
         сразу отдаёт его наружу. С переносом это значило, что до чипов,
         оказавшихся на второй строке, можно добраться только девятью нажатиями
         вправо — а «вниз» уводило сразу в сетку. Здесь ряды вложены в колонку,
         и вверх-вниз ходит между ними как положено. -->

    <!-- Высота задана явно у обеих строк фильтров. Без неё строка тянется по
         самому высокому содержимому, и любой элемент, выросший на кадр (кнопка
         с длинной подписью, появившийся индикатор), сдвигал вниз всю сетку. -->
    <brls:Box
        axis="row"
        height="44"
        alignItems="center"
        marginBottom="@style/hub/space/xs">

        <!-- Подпись к порогам. Без неё на экране стояли чипы «от 3», «от 4»
             и слово «игроков» не встречалось нигде: от чего именно «от», надо
             было догадываться. -->
        <brls:Label
            text="@i18n/hub/filter/players_caption"
            fontSize="@style/hub/font/caption"
            marginRight="@style/hub/space/s"
            textColor="@theme/brls/text_disabled" />

        <brls:Box
            id="catalog/players"
            axis="row"
            alignItems="center" />

        <brls:ProgressSpinner
            id="catalog/spinner"
            width="22"
            height="22"
            marginLeft="@style/hub/space/s"
            visibility="gone" />

        <!-- Счётчик стоит сразу за фильтрами, которым отвечает, и обычным
             цветом. Прижатый к правому краю и приглушённый, он оказывался
             дальше всего от того, что на него влияет, — при том что это
             единственный отклик на нажатие фильтра. -->
        <brls:Label
            id="catalog/count"
            text=""
            fontSize="@style/hub/font/caption"
            marginLeft="@style/hub/space/m"
            textColor="@theme/brls/text" />

        <!-- Распорка: всё, что до неё, прижато влево, сортировка — вправо. -->
        <brls:Box grow="1.0" />

        <!-- Сортировка отделена от фильтров намеренно: она не сужает список, а
             меняет порядок, и в общем ряду её чип терялся бы среди них. Здесь
             она прижата к правому краю и подписана. -->
        <brls:Label
            text="@i18n/hub/filter/sort"
            fontSize="@style/hub/font/caption"
            marginRight="@style/hub/space/s"
            textColor="@theme/brls/text_disabled" />

        <brls:Button
            id="catalog/sort"
            width="auto"
            height="auto"
            text="" />

    </brls:Box>

    <brls:Box
        id="catalog/toggles"
        axis="row"
        height="44"
        alignItems="center"
        marginBottom="@style/hub/space/s" />

    <brls:Label
        id="catalog/empty"
        text="@i18n/hub/filter/empty"
        fontSize="@style/hub/font/body"
        textColor="@theme/brls/text_disabled"
        visibility="gone"
        marginTop="@style/hub/space/l"
        horizontalAlign="center" />

    <brls:RecyclerFrame
        id="catalog/recycler"
        width="auto"
        height="auto"
        grow="1.0" />

</brls:Box>
