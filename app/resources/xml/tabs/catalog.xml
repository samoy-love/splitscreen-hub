<!-- Фильтры уложены в одну строку. Раньше их было две по 44 точки плюс отступы,
     и вместе с шапкой AppletFrame на сетку оставалось меньше двух рядов. -->
<brls:Box
    axis="column"
    width="auto"
    height="auto"
    paddingTop="4"
    paddingRight="30"
    paddingBottom="4"
    paddingLeft="30">

    <!-- WrapBox: если жанр окажется длинным, чипы перенесутся на вторую строку,
         а не уедут за край экрана. -->
    <WrapBox
        id="catalog/toggles"
        axis="row"
        alignItems="center"
        marginBottom="6" />

    <brls:Label
        id="catalog/empty"
        text="Ничего не нашлось. Ослабьте фильтр — например, снимите «только мои»."
        fontSize="16"
        textColor="@theme/brls/text_disabled"
        visibility="gone"
        marginTop="40"
        horizontalAlign="center" />

    <brls:RecyclerFrame
        id="catalog/recycler"
        width="auto"
        height="auto"
        grow="1.0" />

</brls:Box>
