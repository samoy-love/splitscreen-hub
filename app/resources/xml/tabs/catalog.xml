<brls:Box
    axis="column"
    width="auto"
    height="auto"
    paddingTop="@style/hub/space/s"
    paddingRight="@style/hub/space/screen"
    paddingBottom="@style/hub/space/xs"
    paddingLeft="@style/hub/space/screen">

    <!-- Два явных ряда вместо одного переносящегося.
         Контейнер-строка в borealis проводит фокус только влево-вправо, а вниз
         сразу отдаёт его наружу. С переносом это значило, что до чипов,
         оказавшихся на второй строке, можно добраться только девятью нажатиями
         вправо — а «вниз» уводило сразу в сетку. Здесь ряды вложены в колонку,
         и вверх-вниз ходит между ними как положено. -->

    <brls:Box
        axis="row"
        alignItems="center"
        marginBottom="@style/hub/space/xs">

        <brls:Box
            id="catalog/players"
            axis="row"
            alignItems="center"
            grow="1.0" />

        <brls:ProgressSpinner
            id="catalog/spinner"
            width="22"
            height="22"
            marginRight="@style/hub/space/s"
            visibility="gone" />

        <brls:Label
            id="catalog/count"
            text=""
            fontSize="@style/hub/font/caption"
            marginRight="@style/hub/space/m"
            textColor="@theme/brls/text_disabled" />

        <!-- Сортировка отделена от фильтров намеренно: она не сужает список, а
             меняет порядок, и раньше её чип стоял в общем ряду и терялся среди
             них. Здесь она прижата к правому краю и подписана. -->
        <brls:Label
            text="@i18n/hub/filter/sort"
            fontSize="@style/hub/font/caption"
            marginRight="@style/hub/space/s"
            textColor="@theme/brls/text_disabled" />

        <brls:Button
            id="catalog/sort"
            width="auto"
            height="auto"
            text="" />

    </brls:Box>

    <brls:Box
        id="catalog/toggles"
        axis="row"
        alignItems="center"
        marginBottom="@style/hub/space/s" />

    <brls:Label
        id="catalog/empty"
        text="@i18n/hub/filter/empty"
        fontSize="@style/hub/font/body"
        textColor="@theme/brls/text_disabled"
        visibility="gone"
        marginTop="@style/hub/space/l"
        horizontalAlign="center" />

    <brls:RecyclerFrame
        id="catalog/recycler"
        width="auto"
        height="auto"
        grow="1.0" />

</brls:Box>
