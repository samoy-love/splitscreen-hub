<brls:Box
    axis="column"
    width="auto"
    height="auto"
    paddingTop="6"
    paddingRight="30"
    paddingBottom="4"
    paddingLeft="30">

    <brls:Box
        axis="row"
        alignItems="center"
        marginBottom="8">

        <!-- Фильтры слева. WrapBox: если название жанра окажется длинным, чипы
             перенесутся на вторую строку, а не уедут за край экрана. -->
        <WrapBox
            id="catalog/toggles"
            axis="row"
            alignItems="center"
            grow="1.0" />

        <!-- Сортировка отделена от фильтров намеренно: она не сужает список, а
             меняет порядок, и раньше её чип стоял в общем ряду и терялся среди
             них. Здесь она прижата к правому краю и подписана. -->
        <brls:Label
            text="Сортировка"
            fontSize="@style/hub/font/caption"
            marginLeft="16"
            marginRight="8"
            textColor="@theme/brls/text_disabled" />

        <brls:Button
            id="catalog/sort"
            width="auto"
            height="auto"
            text="" />

    </brls:Box>

    <brls:Label
        id="catalog/empty"
        text="Ничего не нашлось. Ослабьте фильтр — например, снимите «Мои»."
        fontSize="@style/hub/font/body"
        textColor="@theme/brls/text_disabled"
        visibility="gone"
        marginTop="40"
        horizontalAlign="center" />

    <brls:RecyclerFrame
        id="catalog/recycler"
        width="auto"
        height="auto"
        grow="1.0" />

</brls:Box>
