<brls:Box
    axis="column"
    width="auto"
    height="auto"
    paddingTop="30"
    paddingRight="60"
    paddingBottom="30"
    paddingLeft="60">

    <brls:Label
        text="Кэш загрузок"
        fontSize="@style/hub/font/title"
        marginBottom="6" />

    <brls:Label
        text="Скриншоты и трейлеры, скачанные при просмотре карточек"
        fontSize="@style/hub/font/caption"
        marginBottom="24"
        textColor="@theme/brls/text_disabled" />

    <brls:Label
        id="cache/summary"
        text="Считаем…"
        fontSize="@style/hub/font/display"
        marginBottom="14" />

    <brls:Label
        id="cache/breakdown"
        text=""
        fontSize="@style/hub/font/body"
        marginBottom="20"
        textColor="@theme/brls/text_disabled" />

    <WrapBox
        axis="row"
        marginBottom="20">

        <brls:Button
            id="cache/clear_videos"
            width="auto"
            height="auto"
            marginRight="12"
            text="Удалить трейлеры" />

        <brls:Button
            id="cache/clear_all"
            width="auto"
            height="auto"
            style="highlight"
            text="Очистить весь кэш" />

    </WrapBox>

    <brls:Label
        id="cache/hint"
        text=""
        fontSize="@style/hub/font/caption"
        textColor="@theme/brls/text_disabled" />

</brls:Box>
