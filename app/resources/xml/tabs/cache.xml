<brls:Box
    axis="column"
    width="auto"
    height="auto"
    paddingTop="@style/hub/space/l"
    paddingRight="@style/hub/space/screen"
    paddingBottom="@style/hub/space/l"
    paddingLeft="@style/hub/space/screen">

    <brls:Label
        text="Кэш загрузок"
        fontSize="@style/hub/font/title"
        marginBottom="@style/hub/space/s" />

    <brls:Label
        text="Скриншоты и трейлеры, скачанные при просмотре карточек"
        fontSize="@style/hub/font/caption"
        marginBottom="@style/hub/space/l"
        textColor="@theme/brls/text_disabled" />

    <brls:Label
        id="cache/summary"
        text="Считаем…"
        fontSize="@style/hub/font/display"
        marginBottom="@style/hub/space/m" />

    <brls:Label
        id="cache/breakdown"
        text=""
        fontSize="@style/hub/font/body"
        marginBottom="@style/hub/space/l"
        textColor="@theme/brls/text_disabled" />

    <WrapBox
        axis="row"
        marginBottom="@style/hub/space/l">

        <brls:Button
            id="cache/clear_videos"
            width="auto"
            height="auto"
            marginRight="@style/hub/space/m"
            text="Удалить трейлеры" />

        <brls:Button
            id="cache/clear_all"
            width="auto"
            height="auto"
            style="highlight"
            text="Очистить весь кэш" />

    </WrapBox>

    <brls:Label
        id="cache/hint"
        text=""
        fontSize="@style/hub/font/caption"
        textColor="@theme/brls/text_disabled" />

</brls:Box>
