<brls:Box
    axis="column"
    width="auto"
    height="auto"
    paddingTop="@style/hub/space/l"
    paddingRight="@style/hub/space/screen"
    paddingBottom="@style/hub/space/l"
    paddingLeft="@style/hub/space/screen">

    <!-- Список настроек рядами с разделителем снизу — как на самой консоли
         (System Settings), а не сплошным текстом. У каждого ряда подпись и
         пояснение слева, элемент управления справа: так видно, к чему он
         относится, без скачков взгляда между текстом и кнопками ниже него. -->

    <brls:Box
        axis="row"
        alignItems="center"
        paddingTop="@style/hub/space/m"
        paddingBottom="@style/hub/space/m"
        lineBottom="1px"
        lineColor="@theme/brls/applet_frame/separator">

        <brls:Box axis="column" grow="1.0" marginRight="@style/hub/space/l">
            <brls:Label
                text="@i18n/hub/settings/language"
                fontSize="@style/hub/font/accent" />

            <!-- Постоянная строка, а не только всплывающее уведомление: оно
                 исчезает через пару секунд, а последствие — до перезапуска
                 язык не сменится — остаётся. -->
            <brls:Label
                text="@i18n/hub/settings/restart"
                fontSize="@style/hub/font/caption"
                marginTop="@style/hub/space/xs"
                textColor="@theme/brls/text_disabled" />
        </brls:Box>

        <!-- Язык применяется при запуске: локаль borealis задаётся до
             создания окна и на ходу не меняется. Кнопки заполняет
             settings_tab.cpp. -->
        <brls:Box
            id="settings/language"
            axis="row"
            alignItems="center" />

    </brls:Box>

    <brls:Box
        axis="column"
        paddingTop="@style/hub/space/m"
        paddingBottom="@style/hub/space/m"
        lineBottom="1px"
        lineColor="@theme/brls/applet_frame/separator">

        <brls:Label
            text="@i18n/hub/settings/cache"
            fontSize="@style/hub/font/accent" />
        <brls:Label
            text="@i18n/hub/cache/subtitle"
            fontSize="@style/hub/font/caption"
            marginTop="@style/hub/space/xs"
            textColor="@theme/brls/text_disabled" />

        <!-- Кегль тела, а не витринный: на пустом кэше «0 МБ из 700 МБ»
             набиралось крупнее всех надписей экрана и перетягивало на себя
             внимание, ничего при этом не сообщая. -->
        <brls:Label
            id="cache/summary"
            text="@i18n/hub/cache/counting"
            fontSize="@style/hub/font/body"
            marginTop="@style/hub/space/s" />

        <brls:Label
            id="cache/breakdown"
            text=""
            fontSize="@style/hub/font/caption"
            marginTop="@style/hub/space/xs"
            textColor="@theme/brls/text_disabled" />

        <!-- Пояснение стоит рядом с числами, которые объясняет, а не под
             кнопками: «Кэш пуст» — это ответ на вопрос «почему тут нули». -->
        <brls:Label
            id="cache/hint"
            text=""
            fontSize="@style/hub/font/caption"
            marginTop="@style/hub/space/xs"
            textColor="@theme/brls/text_disabled" />

        <!-- Кнопки на всю ширину карточки, а не сбоку от текста: сбоку им
             не хватало места и вторая переносилась на свою строку, обрезанную
             высотой ряда, — оставалась серым прямоугольником без подписи. -->
        <WrapBox
            axis="row"
            marginTop="@style/hub/space/m">

            <!-- Без style="highlight": опасное действие не должно быть самым
                 привлекательным на экране. -->
            <brls:Button
                id="cache/clear_all"
                width="auto"
                height="auto"
                text="@i18n/hub/cache/clear_all" />

        </WrapBox>

    </brls:Box>

</brls:Box>
