<brls:Box
    axis="column"
    width="auto"
    height="auto"
    backgroundColor="#000000">

    <!-- Кадры рисуются кодом (VideoSurface) в этот контейнер на весь экран. -->
    <brls:Box
        id="video/box"
        width="auto"
        height="auto"
        grow="1.0"
        axis="column"
        justifyContent="center"
        alignItems="center" />

    <brls:Label
        id="video/status"
        text="Загрузка трейлера…"
        fontSize="@style/hub/font/accent"
        positionType="absolute"
        positionTop="40"
        positionLeft="0"
        positionRight="0"
        horizontalAlign="center"
        textColor="#FFFFFF" />

    <!-- Значок паузы вместо надписи: белый текст пропадал на светлом кадре.
         Тёмная подложка со скруглением видна на любом фоне, а две полосы
         внутри — это и есть привычный знак паузы, без зависимости от шрифта. -->
    <brls:Box
        id="video/pause"
        width="76"
        height="76"
        positionType="absolute"
        positionTop="0"
        positionBottom="0"
        positionLeft="0"
        positionRight="0"
        justifyContent="center"
        alignItems="center"
        cornerRadius="38"
        backgroundColor="#000000A0"
        visibility="gone">

        <brls:Box width="10" height="34" marginRight="@style/hub/space/s" cornerRadius="2"
                  backgroundColor="#FFFFFF" />
        <brls:Box width="10" height="34" cornerRadius="2"
                  backgroundColor="#FFFFFF" />

    </brls:Box>

    <!-- Полоса прогресса поверх нижнего края кадра. Тёмная подложка нужна,
         чтобы шкала читалась и на светлом видео. -->
    <brls:Box
        id="video/bar"
        axis="row"
        alignItems="center"
        height="46"
        positionType="absolute"
        positionBottom="0"
        positionLeft="0"
        positionRight="0"
        paddingLeft="@style/hub/space/screen"
        paddingRight="@style/hub/space/screen"
        backgroundColor="#00000090">

        <brls:Label
            id="video/elapsed"
            text="0:00"
            fontSize="@style/hub/font/caption"
            marginRight="@style/hub/space/m"
            textColor="#FFFFFF" />

        <!-- Дорожка, а в ней две полосы: сколько закачано и сколько показано.
             Обе позиционированы абсолютно, чтобы задавать им только ширину. -->
        <brls:Box
            id="video/track"
            height="6"
            grow="1.0"
            cornerRadius="3"
            backgroundColor="#FFFFFF33">

            <brls:Box
                id="video/loaded"
                width="0"
                height="6"
                positionType="absolute"
                positionLeft="0"
                cornerRadius="3"
                backgroundColor="#FFFFFF66" />

            <brls:Box
                id="video/played"
                width="0"
                height="6"
                positionType="absolute"
                positionLeft="0"
                cornerRadius="3"
                backgroundColor="@theme/brls/accent" />

        </brls:Box>

        <brls:Label
            id="video/left"
            text=""
            fontSize="@style/hub/font/caption"
            marginLeft="@style/hub/space/m"
            textColor="#FFFFFFC0" />

    </brls:Box>

</brls:Box>
