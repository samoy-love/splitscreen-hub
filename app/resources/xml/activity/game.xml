<brls:AppletFrame
    iconInterpolation="linear"
    headerHidden="true"
    footerHidden="false">

    <brls:Box
        axis="column"
        width="auto"
        height="auto">

        <brls:Box
            id="game/header"
            axis="row"
            alignItems="center"
            height="86"
            paddingLeft="30"
            paddingRight="30">

            <brls:Image
                id="game/cover"
                width="62"
                height="62"
                cornerRadius="6"
                marginRight="16"
                scalingType="fill" />

            <brls:Box axis="column" grow="1.0">
                <brls:Label
                    id="game/title"
                    text=""
                    fontSize="22"
                    textColor="#FFFFFF"
                    singleLine="true" />
                <brls:Label
                    id="game/subtitle"
                    text=""
                    fontSize="14"
                    marginTop="2"
                    textColor="#FFFFFFB0" />
            </brls:Box>

            <!-- Индикаторы избранного и папки: действия по кнопкам X и Y,
                 здесь только состояние. -->
            <brls:Label
                id="game/star"
                text="★"
                fontSize="20"
                marginRight="12"
                textColor="#FFFFFF"
                visibility="gone" />

            <brls:Label
                id="game/folders"
                text=""
                fontSize="13"
                textColor="#FFFFFFB0"
                visibility="gone" />

        </brls:Box>

        <brls:ScrollingFrame
            width="auto"
            height="auto"
            grow="1.0">

            <brls:Box
                axis="column"
                width="auto"
                height="auto"
                paddingTop="14"
                paddingRight="30"
                paddingBottom="24"
                paddingLeft="30">

                <brls:Box
                    id="game/stats"
                    axis="row"
                    marginBottom="12" />

                <brls:Label
                    id="game/players_note"
                    text=""
                    fontSize="14"
                    marginBottom="10"
                    textColor="@theme/brls/accent"
                    visibility="gone" />

                <WrapBox
                    id="game/tags"
                    axis="row"
                    marginBottom="12" />

                <brls:Label
                    id="game/genres"
                    text=""
                    fontSize="13"
                    marginBottom="10"
                    textColor="@theme/brls/text_disabled"
                    visibility="gone" />

                <brls:Label
                    id="game/headline"
                    text=""
                    fontSize="16"
                    marginBottom="12" />

                <brls:Label
                    id="game/shots_hint"
                    text=""
                    fontSize="13"
                    marginBottom="4"
                    textColor="@theme/brls/text_disabled"
                    visibility="gone" />

                <!-- Медиа одной полосой: трейлер и скриншоты — это одно и то же
                     «посмотреть, как выглядит игра», и разносить их по разным
                     местам экрана незачем. Кнопка трейлера встаёт первой прямо
                     здесь, в game_activity.cpp.

                     Высота задана явно и вместе с width=auto: без этого строка
                     не резервировала себе места в колонке, и описание рисовалось
                     поверх картинок. -->
                <brls:Box
                    id="game/shots"
                    axis="row"
                    alignItems="center"
                    width="auto"
                    height="128"
                    marginBottom="14" />

                <brls:Label
                    id="game/description"
                    text=""
                    fontSize="14"
                    textColor="@theme/brls/text_disabled" />

            </brls:Box>

        </brls:ScrollingFrame>

    </brls:Box>

</brls:AppletFrame>
