<brls:AppletFrame
    iconInterpolation="linear"
    headerHidden="true"
    footerHidden="false">

    <!-- HubScreen вместо Box: тот же контейнер, но с подъёмом при появлении. -->
    <HubScreen
        width="auto"
        height="auto">

        <brls:Box
            id="game/header"
            axis="row"
            alignItems="center"
            height="96"
            paddingLeft="@style/hub/space/screen"
            paddingRight="@style/hub/space/screen">

            <brls:Image
                id="game/cover"
                width="70"
                height="70"
                cornerRadius="6"
                marginRight="@style/hub/space/m"
                scalingType="fill" />

            <brls:Box axis="column" grow="1.0">
                <brls:Label
                    id="game/title"
                    text=""
                    fontSize="@style/hub/font/title"
                    textColor="#FFFFFF"
                    singleLine="true" />
                <brls:Label
                    id="game/subtitle"
                    text=""
                    fontSize="@style/hub/font/caption"
                    marginTop="@style/hub/space/xs"
                    textColor="#FFFFFFB0" />
            </brls:Box>

            <!-- Индикаторы избранного и папки: действия по кнопкам X и Y,
                 здесь только состояние. -->
            <brls:Label
                id="game/star"
                text="★"
                fontSize="@style/hub/font/title"
                marginRight="@style/hub/space/m"
                textColor="#FFFFFF"
                visibility="gone" />

            <brls:Label
                id="game/folders"
                text=""
                fontSize="@style/hub/font/caption"
                textColor="#FFFFFFB0"
                visibility="gone" />

        </brls:Box>

        <brls:ScrollingFrame
            id="game/scroll"
            width="auto"
            height="auto"
            grow="1.0">

            <brls:Box
                axis="column"
                width="auto"
                height="auto"
                paddingTop="@style/hub/space/m"
                paddingRight="@style/hub/space/screen"
                paddingBottom="@style/hub/space/l"
                paddingLeft="@style/hub/space/screen">

                <brls:Box
                    id="game/stats"
                    axis="row"
                    marginBottom="@style/hub/space/m" />

                <brls:Label
                    id="game/players_note"
                    text=""
                    fontSize="@style/hub/font/body"
                    marginBottom="@style/hub/space/s"
                    textColor="@theme/brls/accent"
                    visibility="gone" />

                <WrapBox
                    id="game/tags"
                    axis="row"
                    marginBottom="@style/hub/space/m" />

                <brls:Label
                    id="game/genres"
                    text=""
                    fontSize="@style/hub/font/caption"
                    marginBottom="@style/hub/space/s"
                    textColor="@theme/brls/text_disabled"
                    visibility="gone" />

                <brls:Label
                    id="game/headline"
                    text=""
                    fontSize="@style/hub/font/accent"
                    marginBottom="@style/hub/space/m" />

                <brls:Label
                    id="game/shots_hint"
                    text=""
                    fontSize="@style/hub/font/caption"
                    marginBottom="@style/hub/space/xs"
                    textColor="@theme/brls/text_disabled"
                    visibility="gone" />

                <!-- Медиа одной полосой: трейлер и скриншоты — это одно и то же
                     «посмотреть, как выглядит игра», и разносить их по разным
                     местам экрана незачем. Кнопка трейлера встаёт первой прямо
                     здесь, в game_activity.cpp.

                     Высота задана явно и вместе с width=auto: без этого строка
                     не резервировала себе места в колонке, и описание рисовалось
                     поверх картинок. -->
                <brls:Box
                    id="game/shots"
                    axis="row"
                    alignItems="center"
                    width="auto"
                    height="128"
                    marginBottom="@style/hub/space/m" />

                <brls:Label
                    id="game/description"
                    text=""
                    fontSize="@style/hub/font/body"
                    textColor="@theme/brls/text_disabled" />

            </brls:Box>

        </brls:ScrollingFrame>

    </HubScreen>

</brls:AppletFrame>
