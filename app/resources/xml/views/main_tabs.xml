<!-- Верхняя строка вкладок вместо левого сайдбара TabFrame. Сайдбар занимал
     410 точек по ширине — треть экрана под три пункта, — и из-за него в сетку
     помещалось вдвое меньше игр. Здесь на вкладки уходит только высота строки. -->
<brls:Box
    axis="column"
    width="auto"
    height="auto">

    <!-- Шапка AppletFrame скрыта, поэтому верхний отступ этой строки —
         единственное, что отделяет интерфейс от края экрана. Без него вкладки
         прилипали к самому верху. Линия снизу отделяет их от содержимого. -->
    <brls:Box
        axis="row"
        alignItems="center"
        height="52"
        paddingTop="10"
        paddingLeft="30"
        paddingRight="30"
        marginBottom="6"
        lineColor="@theme/brls/applet_frame/separator"
        lineBottom="1px">

        <brls:Label
            text="Split Screen Hub"
            fontSize="@style/hub/font/body"
            marginRight="24"
            textColor="@theme/brls/text_disabled" />

        <brls:Box
            id="main/tabs"
            axis="row"
            alignItems="center"
            grow="1.0" />

        <!-- Подсказки, вытесненные из нижней полосы: там они занимали почти
             400 точек и наезжали на часы с индикаторами. Здесь строка всё
             равно наполовину пуста. Значки  и  — L и R из
             системного шрифта Nintendo, те же, что рисует borealis. -->
        <brls:Label
            id="main/shortcuts"
            text=""
            fontSize="@style/hub/font/caption"
            textColor="@theme/brls/text_disabled" />

    </brls:Box>

    <brls:Box
        id="main/content"
        axis="column"
        width="auto"
        height="auto"
        grow="1.0" />

</brls:Box>
