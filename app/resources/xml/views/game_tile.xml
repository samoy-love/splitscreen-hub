<!-- Размер плитки подобран под ширину экрана: восемь штук по 140 с зазором 12
     занимают 1204 из 1220 доступных точек, то есть сетка идёт во всю ширину.
     Обложки в базе квадратные (256×256), поэтому и картинка квадратная. -->
<brls:Box
    axis="column"
    width="140"
    height="166"
    focusable="true"
    cornerRadius="6">

    <brls:Box
        width="140"
        height="140">

        <brls:Image
            id="tile/cover"
            width="140"
            height="140"
            cornerRadius="6"
            scalingType="fill" />

        <brls:Label
            id="tile/star"
            text="★"
            fontSize="15"
            positionType="absolute"
            positionTop="4"
            positionLeft="6"
            textColor="#FFFFFF"
            visibility="gone" />

        <brls:Box
            id="tile/installed"
            width="8"
            height="8"
            cornerRadius="4"
            positionType="absolute"
            positionTop="7"
            positionRight="7"
            backgroundColor="#4CD964"
            visibility="gone" />

        <!-- Отступы внутри умеет только Box, поэтому подложка счётчика игроков
             вынесена в отдельный контейнер, а Label внутри остался чистым. -->
        <brls:Box
            width="auto"
            height="auto"
            positionType="absolute"
            positionBottom="4"
            positionRight="5"
            paddingLeft="6"
            paddingRight="6"
            cornerRadius="8"
            backgroundColor="#000000B0">

            <brls:Label
                id="tile/players"
                text=""
                fontSize="13"
                textColor="#FFFFFF" />

        </brls:Box>

    </brls:Box>

    <brls:Label
        id="tile/name"
        text=""
        fontSize="13"
        marginTop="4"
        singleLine="true" />

</brls:Box>
