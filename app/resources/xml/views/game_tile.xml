<!-- Размер подобран под ширину экрана: семь плиток по 160 с зазором 14
     занимают 1204 из 1220 доступных точек. Восемь по 140 помещалось больше, но
     названия при этом читались с трудом — здесь и плитка, и подпись крупнее.
     Обложки в базе квадратные (256×256), поэтому и картинка квадратная. -->
<brls:Box
    axis="column"
    width="160"
    height="198"
    focusable="true"
    cornerRadius="6">

    <brls:Box
        width="160"
        height="160">

        <brls:Image
            id="tile/cover"
            width="160"
            height="160"
            cornerRadius="6"
            scalingType="fill" />

        <brls:Label
            id="tile/star"
            text="★"
            fontSize="@style/hub/font/caption"
            positionType="absolute"
            positionTop="4"
            positionLeft="6"
            textColor="#FFFFFF"
            visibility="gone" />

        <brls:Box
            id="tile/installed"
            width="8"
            height="8"
            cornerRadius="4"
            positionType="absolute"
            positionTop="7"
            positionRight="7"
            backgroundColor="#4CD964"
            visibility="gone" />

        <!-- Отступы внутри умеет только Box, поэтому подложка счётчика игроков
             вынесена в отдельный контейнер, а Label внутри остался чистым. -->
        <!-- Высота задана явно, содержимое центрировано по обеим осям: без
             этого подложка обтягивала глифы вплотную и цифра сидела в ней
             криво. Ширина по содержимому — счётчик бывает и двузначным,
             максимум в базе 12. -->
        <brls:Box
            width="auto"
            height="21"
            positionType="absolute"
            positionBottom="5"
            positionRight="5"
            paddingLeft="8"
            paddingRight="8"
            justifyContent="center"
            alignItems="center"
            cornerRadius="10"
            backgroundColor="#000000C8">

            <brls:Label
                id="tile/players"
                text=""
                fontSize="@style/hub/font/caption"
                verticalAlign="center"
                horizontalAlign="center"
                textColor="#FFFFFF" />

        </brls:Box>

    </brls:Box>

    <brls:Label
        id="tile/name"
        text=""
        fontSize="@style/hub/font/caption"
        marginTop="6"
        singleLine="true" />

</brls:Box>
