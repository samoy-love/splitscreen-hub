<!-- Размер подобран под ширину экрана: семь плиток по 160 с зазором 14
     занимают 1204 из 1220 доступных точек. Восемь по 140 помещалось больше, но
     названия при этом читались с трудом — здесь и плитка, и подпись крупнее.
     Обложки квадратные (240×240 — ровно размер плитки в доке), поэтому и
     картинка квадратная. -->
<brls:Box
    axis="column"
    width="160"
    height="218"
    focusable="true"
    cornerRadius="6">

    <brls:Box
        width="160"
        height="160">

        <brls:Image
            id="tile/cover"
            width="160"
            height="160"
            cornerRadius="6"
            scalingType="fill" />

        <brls:Label
            id="tile/star"
            text="★"
            fontSize="@style/hub/font/caption"
            positionType="absolute"
            positionTop="4"
            positionLeft="6"
            textColor="#FFFFFF"
            visibility="gone" />

        <!-- Метка «игра стоит на консоли». Крупная и с тёмной обводкой: точка
             поменьше и без обводки терялась бы на пёстрых обложках. -->
        <brls:Box
            id="tile/installed"
            width="14"
            height="14"
            cornerRadius="7"
            positionType="absolute"
            positionTop="6"
            positionRight="6"
            backgroundColor="#4CD964"
            borderColor="#000000A0"
            borderThickness="2"
            visibility="gone" />

        <!-- Отступы внутри умеет только Box, поэтому подложка счётчика игроков
             вынесена в отдельный контейнер, а Label внутри остался чистым. -->
        <!-- Высота задана явно, содержимое центрировано по обеим осям: без
             этого подложка обтягивала глифы вплотную и цифра сидела в ней
             криво. Ширина по содержимому — счётчик бывает и двузначным. -->
        <brls:Box
            width="auto"
            height="21"
            positionType="absolute"
            positionBottom="5"
            positionRight="5"
            paddingLeft="8"
            paddingRight="8"
            justifyContent="center"
            alignItems="center"
            cornerRadius="10"
            backgroundColor="#000000C8">

            <brls:Label
                id="tile/players"
                text=""
                fontSize="@style/hub/font/caption"
                verticalAlign="center"
                horizontalAlign="center"
                textColor="#FFFFFF" />

        </brls:Box>

    </brls:Box>

    <!-- Две строки вместо одной: в 160 точек при кегле 15 влезает около
         восемнадцати знаков, и названия обрывались на середине слова —
         «Teenage Mutant Ni…», «Kirby and the Forg…».

         Ширина задана, высота — нет, и это важно. Yoga вызывает измеряющую
         функцию, только когда размер не определён целиком; при заданных обеих
         сторонах она не вызывается вовсе. А это она включает перенос и считает
         requiredWidth, без которого Label не обрезает текст (label.cpp:594).
         С фиксированной высотой подпись не переносилась и не обрезалась —
         рисовалась одной строкой поверх соседних плиток.

         Высоту плитки это не меняет: она задана сверху, а число строк
         ограничивает textfit::ellipsizeHeight() в game_tile.cpp. -->
    <brls:Label
        id="tile/name"
        text=""
        width="160"
        fontSize="@style/hub/font/caption"
        marginTop="6"
        lineHeight="1.15" />

</brls:Box>
