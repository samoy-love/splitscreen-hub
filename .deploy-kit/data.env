# Цель-файл: бандл данных каталога на samoy.love/splitscreen-hub/.
#
# Обложки, catalog.bin, details.bin и translations.db — материалы издателей,
# в git их нет (см. .gitignore). Живут они здесь: пайплайн собирает их на
# машине разработчика, эта цель упаковывает и публикует, а сборка .nro
# (app/tools/build_release.sh) скачивает бандл, если файлов на месте нет —
# так CI собирает то же самое, что и локальная сборка.
#
# Катится только руками, после прогона пайплайна:
#   dk deploy splitscreen-hub-data
# В deploy.yml эта цель не подключена: раннеру собирать её не из чего.
APP=splitscreen-hub-data
TITLE='SplitScreen Hub · Данные каталога'

BUILD_CMD='bash app/tools/pack_data.sh'
ARTIFACT_FILE=app/build/splitscreen-hub-data.tar.gz

# Версия бандла — отпечаток содержимого: у данных нет своей нумерации, а
# два разных набора обязаны отличаться и по манифесту.
VERSION_CMD="cat app/resources/catalog.bin app/resources/details.bin | sha256sum | cut -c1-12"

PUBLISH_DEST=/var/www/splitscreen-hub/splitscreen-hub-data.tar.gz
VERIFY_URL=https://samoy.love/splitscreen-hub/splitscreen-hub-data.tar.gz.sha256

HEALTH=https://samoy.love/splitscreen-hub/splitscreen-hub-data.tar.gz.json
NOTIFY=all
