# Цель-файл: SplitScreenHub.nro на samoy.love/splitscreen-hub/.
#
# Это описание читают ОБА пути выкатки — правка здесь меняет оба разом:
#   * пайплайн: job nro в .github/workflows/deploy.yml зовёт
#     desktop-artifact.yml из deploy-kit с runner=ubuntu-latest;
#   * локально: dk deploy splitscreen-hub (или dk deploy из этого репозитория).
#
# Публикует publish-file.sh на сервере: атомарная подмена файла, прежний
# остаётся жёсткой ссылкой .prev, рядом ложатся .sha256 и .json — манифест,
# по которому приложение на консоли само предлагает обновиться.
APP=splitscreen-hub
TITLE='SplitScreen Hub · Приложение для Switch'

# Одна и та же строка на раннере (docker с devkitPro) и на машине
# разработчика (msys2 из комплекта devkitPro) — различает окружения сам скрипт.
BUILD_CMD='bash app/tools/build_release.sh'
ARTIFACT_FILE=app/build/SplitScreenHub.nro

# Версию объявляет CMakeLists — ровно та, что уезжает в .nacp и которую
# приложение сравнивает с манифестом на сервере.
VERSION_CMD="sed -n 's/^set(VERSION_\(MAJOR\|MINOR\|ALTER\) \"\([0-9]*\)\")/\2/p' app/CMakeLists.txt | paste -sd. -"

# Кеш между прогонами пайплайна (читает desktop-artifact.yml в deploy-kit;
# локальной выкатке не нужен — там всё и так лежит в дереве):
#   * lib/ffmpeg-slim — урезанный FFmpeg, минуты сборки в контейнере;
#     устаревает вместе со скриптом сборки;
#   * build/data-cache — скачанный бандл данных каталога по его sha256;
#     сумма с сервера входит в ключ, поэтому новые данные — новый ключ.
CACHE_PATHS='app/lib/ffmpeg-slim
app/build/data-cache'
CACHE_KEY_FILES='app/tools/build_ffmpeg_slim.sh app/tools/build_release.sh'
CACHE_KEY_CMD='curl -fsS --max-time 20 https://samoy.love/splitscreen-hub/splitscreen-hub-data.tar.gz.sha256'

PUBLISH_DEST=/var/www/splitscreen-hub/SplitScreenHub.nro
VERIFY_URL=https://samoy.love/splitscreen-hub/SplitScreenHub.nro.sha256

HEALTH=https://samoy.love/splitscreen-hub/SplitScreenHub.nro.json
NOTIFY=all

# отметка замера пайплайнов 2026-09-04
